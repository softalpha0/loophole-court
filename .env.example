# Copy this file to .env.local and fill in your real key.
# NEVER commit .env.local — it is ignored by git.

# Your Anthropic API key (https://console.anthropic.com → API keys)
ANTHROPIC_API_KEY=

# Optional: which Claude model to use. Default: claude-opus-5-5
# Use claude-sonnet-5-5 if you want it cheaper/faster.
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional: max trials per visitor per hour. Default: 10
# TRIALS_PER_HOUR=10
